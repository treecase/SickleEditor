[library]
version = "@version@"
authors = "Treecase"
license = "GPL-3.0-or-later"
website_url = "https://github.com/treecase/SickleEditor"
browse_url = "https://github.com/treecase/SickleEditor"
description = "RMF loading library"
devhelp = true
search_index = true
dependencies = ["GObject-2.0", "Gio-2.0"]

  [dependencies."GObject-2.0"]
  name = "GObject"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/gobject/"

  [dependencies."Gio-2.0"]
  name = "Gio"
  description = "GObject Interfaces and Objects, Networking, IPC, and I/O"
  docs_url = "https://docs.gtk.org/gio/"

[theme]
name = "basic"
show_index_summary = true
show_class_heirarchy = true

[source-location]
base_url = "https://github.com/treecase/SickleEditor/-/blob/main"

[extra]
content_files = []
content_images = []

